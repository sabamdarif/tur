diff --git a/desktop/source/app/app.cxx b/desktop/source/app/app.cxx
index 6ccb2d5f3..455489aa6 100644
--- a/desktop/source/app/app.cxx
+++ b/desktop/source/app/app.cxx
@@ -1766,7 +1766,21 @@ int Desktop::Main()
 
         if ( !rCmdLineArgs.IsInvisible() &&
              !rCmdLineArgs.IsNoQuickstart() )
+        {
+#if defined(__ANDROID__)
+            try
+            {
+                InitializeQuickstartMode( xContext );
+            }
+            catch (...)
+            {
+                fprintf(stderr, "WARNING: InitializeQuickstartMode threw exception, skipped on Android\n");
+                fflush(stderr);
+            }
+#else
             InitializeQuickstartMode( xContext );
+#endif
+        }
 
         if ( xDesktop.is() )
             xDesktop->addTerminateListener( new RequestHandlerController );
